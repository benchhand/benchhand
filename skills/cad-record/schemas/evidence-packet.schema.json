{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srobroek.com/cad/schemas/evidence-packet.schema.json",
  "title": "CAD evidence packet (evidence.py check)",
  "description": "The aggregate evidence of one built version of a record version 2 project at one stage gate, as evidence.py check prints it and cad-recheck stamps it: the expected checks, each one's status and service-class scope, the facets, the typed verification rows, the evidence findings, the selection summary and the gate. cad-recheck seals version 2 only; it still reads a version 1 packet that an older stamp sealed, which has no scope_rules_sha256 and no status scope",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "schema_version", "record_version", "version", "version_manifest_sha256", "record_sha256", "expected_sha256", "stage", "scope_rules_sha256", "expected", "statuses", "facets", "verification", "findings", "critical", "complete", "selection", "gate"],
  "properties": {
    "kind": {"const": "cad-evidence-packet"},
    "schema_version": {"const": 2},
    "record_version": {"$ref": "manufacturing.schema.json#/$defs/record_version"},
    "version": {"description": "the built version assessed, such as v3; null when none was named", "type": ["string", "null"]},
    "version_manifest_sha256": {"description": "sha256 of that version's manifest", "$ref": "#/$defs/sha256_or_null"},
    "record_sha256": {"description": "the digest of the record inputs the packet was computed from (evidence.record_digest)", "$ref": "product.schema.json#/$defs/sha256"},
    "expected_sha256": {"description": "sha256 of the expected checks in their schema form, as canonical JSON", "$ref": "product.schema.json#/$defs/sha256"},
    "stage": {"description": "the gate the packet applies", "$ref": "product.schema.json#/$defs/stage"},
    "scope_rules_sha256": {"description": "the digest of the project_scope RULES and the service class that judged the packet (project_scope.rules_sha256); a packet that other rules judged is stale", "$ref": "product.schema.json#/$defs/sha256"},
    "expected": {"description": "every check the record implies (manufacturing_intent.required_checks)", "type": "array", "items": {"$ref": "manufacturing.schema.json#/$defs/obligation"}},
    "statuses": {"description": "per expected check id, what it has shown", "type": "object", "additionalProperties": {"$ref": "#/$defs/status"}},
    "facets": {"description": "per requirement, part, interface, assembly operation and the product: each evidence level's result, the worst over its checks", "type": "object", "additionalProperties": {"$ref": "#/$defs/facet"}},
    "verification": {"description": "the typed verification.csv rows", "type": "array", "items": {"$ref": "#/$defs/verification_row"}},
    "findings": {"description": "the findings about the evidence itself", "type": "array", "items": {"$ref": "#/$defs/finding"}},
    "critical": {"description": "the unresolved critical producer findings", "type": "array", "items": {"$ref": "#/$defs/critical"}},
    "complete": {"description": "false when a producer packet was partial or invalid", "type": "boolean"},
    "selection": {"$ref": "#/$defs/selection"},
    "gate": {"$ref": "#/$defs/gate"}
  },
  "$defs": {
    "sha256_or_null": {"anyOf": [{"$ref": "product.schema.json#/$defs/sha256"}, {"type": "null"}]},
    "result": {"description": "An obligation's status: pass, waived and not_applicable resolve it; not_assessed blocks nothing and is never a pass; unknown, planned and stale never become pass", "enum": ["pass", "fail", "waived", "not_applicable", "not_assessed", "stale", "planned", "unknown"]},
    "scope": {
      "description": "What the project's service class owes the check (project_scope.ProjectScope.obligation_scope)",
      "type": "object", "additionalProperties": false,
      "required": ["disposition", "rule", "reason"],
      "properties": {
        "disposition": {"description": "required blocks at its due stage; out_of_scope blocks no gate and stays unclaimed", "enum": ["required", "check_before_use", "advisory", "out_of_scope"]},
        "rule": {"description": "the id of the RULES row that decides it", "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
        "reason": {"$ref": "manufacturing.schema.json#/$defs/text"}
      }
    },
    "status": {
      "type": "object", "additionalProperties": false,
      "required": ["result", "level", "stage", "sources", "reasons", "scope"],
      "properties": {
        "result": {"$ref": "#/$defs/result"},
        "level": {"$ref": "manufacturing.schema.json#/$defs/evidence_level"},
        "stage": {"$ref": "product.schema.json#/$defs/stage"},
        "sources": {"description": "the producer bundles and evidence ids that decided it, or record", "type": "array", "items": {"type": "string"}},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "waiver": {"description": "the waiver of a waived check, as the evidence ledger records it", "type": "object"},
        "scope": {"$ref": "#/$defs/scope"}
      }
    },
    "facet": {
      "type": "object",
      "propertyNames": {"$ref": "manufacturing.schema.json#/$defs/evidence_level"},
      "additionalProperties": {"anyOf": [{"$ref": "#/$defs/result"}, {"description": "no check applies at this level", "const": "not_required"}]}
    },
    "verification_row": {
      "type": "object", "additionalProperties": false,
      "required": ["requirement", "method", "criterion", "acceptance", "stated", "result", "levels", "evidence"],
      "properties": {
        "requirement": {"type": "string"},
        "method": {"type": ["string", "null"]},
        "criterion": {"description": "the requirement's criteria, or the row's criteria for an unknown requirement"},
        "acceptance": {"type": "array"},
        "stated": {"description": "the result the CSV row states", "type": "string"},
        "result": {"description": "the result its evidence shows", "$ref": "#/$defs/result"},
        "levels": {"type": "object", "additionalProperties": {"$ref": "#/$defs/result"}},
        "evidence": {"description": "the ledger entries the row rests on", "type": "array", "items": {"type": "object"}}
      }
    },
    "finding": {
      "description": "An evidence, gate or release finding (evidence.Finding)",
      "type": "object", "additionalProperties": false,
      "required": ["path", "message", "severity", "code", "canonical_location", "action"],
      "properties": {
        "path": {"description": "the project-relative path it is about", "type": "string"},
        "message": {"type": "string"},
        "severity": {"description": "error blocks the gate; warning and info do not", "enum": ["error", "warning", "info"]},
        "code": {"$ref": "manufacturing.schema.json#/$defs/finding_code"},
        "canonical_location": {"type": ["string", "null"]},
        "action": {"type": ["string", "null"]},
        "obligation": {"description": "the expected check it is about", "type": "string"}
      }
    },
    "critical": {
      "type": "object", "additionalProperties": false,
      "required": ["finding", "code", "bundle", "obligation", "consequence"],
      "properties": {
        "finding": {"type": ["string", "null"]},
        "code": {"type": ["string", "null"]},
        "bundle": {"type": "string"},
        "obligation": {"type": ["string", "null"]},
        "consequence": {"type": ["string", "null"]}
      }
    },
    "selection": {
      "description": "The selection report of the same record (selection.py), as the packet summarizes it",
      "type": "object", "additionalProperties": false,
      "required": ["status", "input_sha256", "recorded", "decisions", "findings"],
      "properties": {
        "status": {"type": ["string", "null"]},
        "input_sha256": {"$ref": "#/$defs/sha256_or_null"},
        "recorded": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "current", "approved"],
          "properties": {
            "status": {"type": ["string", "null"]},
            "current": {"type": ["boolean", "null"]},
            "approved": {"description": "whether the confirming decision is the user's approval; null when not confirmed", "type": ["boolean", "null"]}
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["parts", "final_allowed", "refused_because"],
            "properties": {
              "parts": {"type": "array", "items": {"type": "string"}},
              "final_allowed": {"type": ["boolean", "null"]},
              "refused_because": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "findings": {"description": "the selection finding codes", "type": "array", "items": {"type": "string"}}
      }
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "passed", "findings"],
      "properties": {
        "stage": {"$ref": "product.schema.json#/$defs/stage"},
        "passed": {"description": "no gate finding is an error", "type": "boolean"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
      }
    }
  }
}

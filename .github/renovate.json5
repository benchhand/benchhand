// Renovate config. Automerge (minor, patch, digest, lock file maintenance) waits for the CI check: Harness, generated files and type check (workflow "CI").
// Majors and 0.x versions never automerge.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Dubai",
  "schedule": [
    "before 6am on Monday"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**"
  ],
  "dependencyDashboard": {
    "enabled": true
  },
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "automerge": false,
  "platformAutomerge": false,
  "automergeType": "pr",
  "ignoreTests": false,
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "3 days",
  "labels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  },
  "pep723": {
    "enabled": true,
    "managerFilePatterns": [
      "/^skills/[^/]+/scripts/[^/]+\\.py$/"
    ]
  },
  "customManagers": [
    {
      "description": "Playwright and other pins in `uv run --with <pkg>==<version>` commands in docs",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.md$/"
      ],
      "matchStrings": [
        "uv run --with (?<depName>[A-Za-z0-9_.\\-]+)==(?<currentValue>[0-9][A-Za-z0-9_.+!\\-]*)"
      ],
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    }
  ],
  "packageRules": [
    {
      "description": "Playwright pins in PEP 723 headers and docs move together in one PR",
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "playwright"
      ],
      "groupName": "playwright"
    },
    {
      "description": "Automerge minor and patch updates (not 0.x) once CI passes",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "description": "Automerge digest and pin updates once CI passes",
      "matchUpdateTypes": [
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "description": "github actions updates",
      "groupName": "github actions",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ]
    },
    {
      "description": "Major updates open their own PR and carry a label",
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "dependencies",
        "major"
      ]
    }
  ]
}
